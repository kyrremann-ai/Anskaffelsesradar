# demo = fiktive data, live = TED + Brreg (+ Doffin hvis nøkkel)
RADAR_MODE=demo
TED_FROM=2025-01-01
# Automatisk oppdatering hver N time (0 = bare manuelt)
REFRESH_HOURS=24

# Gratis nøkkel fra DFØs API-portal (Doffin Public API v2)
# Gratis nøkkel fra DFØs API-portal. Gir Doffin-tildelinger (også under EØS-terskel) og «Doffin live».
DOFFIN_API_KEY=
# Mistral (EU). Tom = regelbasert mal i stedet for LLM.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Claude til demoer (velges når LLM_PROVIDER=claude, eller når bare denne nøkkelen er satt)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
LLM_PROVIDER=

# Hemmelig salt for person-nøkler fra Brreg-roller. Lag med: openssl rand -hex 32
# ALDRI endre etter første kjøring: alle koblinger av personer på tvers av virksomheter brytes.
# Pipelinen stopper hvis saltet er endret. Bytte krever full re-indeksering (python -m radar.reindex_persons).
# Ta vare på verdien sammen med sikkerhetskopien: en gjenopprettet database er ubrukelig uten den.
PERSON_SALT=bytt-til-en-lang-tilfeldig-streng
BRREG_USER_AGENT=Anskaffelsesradar/2.0 (kontakt: din@epost.no)

# --- Tilleggskilder (live) ---
# Regnskapsregisteret (åpent). 1 = på
REGNSKAP=1
# Proff API (valgfritt, krever avtale med Proff). Tom = av. Vi skraper ikke proff.no.
PROFF_API_KEY=
PROFF_BASE_URL=https://api.proff.no
PROFF_AUTH_SCHEME=Token
# Arbeidstilsynets registre (åpne, NLOD). Tom = av.
RENHOLD_REGISTER_URL=https://registerdata.arbeidstilsynet.no/renhold_register.xml
# Krever trolig nøkkel, se openapi.arbeidstilsynet.no
BEMANNING_REGISTER_URL=
# OpenSanctions: CC BY-NC. All bruk i en kommersiell virksomhet krever lisens, også compliance-screening.
# Av som standard. For å slå på må både URL og OPENSANCTIONS_LISENS settes:
#   kommersiell       kunden har egen lisens fra OpenSanctions
#   ikke-kommersiell  avklart med OpenSanctions at bruken er ikke-kommersiell
# https://data.opensanctions.org/datasets/latest/default/targets.simple.csv
OPENSANCTIONS_URL=
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_LISENS=
# Klagerisiko trenes bare på KOFA-koblinger med minst denne konfidensen (se radar/ingest/kofa_link.py)
KOFA_MIN_CONFIDENCE=0.7
# Filer i data/import/ leses ved hver oppdatering:
#   aksjonaer*.csv (Skatteetaten), kandidat*.csv (valg.no), kofa*.csv|json

# --- Innlogging ---
DOMAIN=radar.example.no
# Endringer i saker og flagg krever innlogget bruker (anbefalt i produksjon)
REQUIRE_USER=1

# Standard: Microsoft Entra ID (OIDC) via oauth2-proxy. Registrer en app i kundens Entra ID med
# redirect-URI https://<DOMAIN>/oauth2/callback, og krev MFA med betinget tilgang.
COMPOSE_PROFILES=oidc
CADDYFILE=Caddyfile
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Lag med: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
# Bare disse e-postdomenene slipper inn (kommaseparert), f.eks. kommune.no,revisjon.no
ALLOWED_EMAIL_DOMAINS=

# Alternativ for test/demo: felles passord (ingen 2FA). Sett COMPOSE_PROFILES= og CADDYFILE=Caddyfile.basic
BASIC_AUTH_USER=revisor
# Lag med: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'passord'
BASIC_AUTH_HASH=
