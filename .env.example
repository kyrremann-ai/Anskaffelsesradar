# demo = fiktive data, live = TED + Brreg (+ Doffin hvis nøkkel)
RADAR_MODE=demo
TED_FROM=2025-01-01
# Automatisk oppdatering hver N time (0 = bare manuelt)
REFRESH_HOURS=24

# Gratis nøkkel fra DFØs API-portal (Doffin Public API v2)
DOFFIN_API_KEY=
# Mistral (EU). Tom = regelbasert mal i stedet for LLM.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Hemmelig salt for person-nøkler fra Brreg-roller. Ikke endre etter første kjøring.
PERSON_SALT=bytt-til-en-lang-tilfeldig-streng
BRREG_USER_AGENT=Anskaffelsesradar/2.0 (kontakt: din@epost.no)

# Caddy
DOMAIN=radar.example.no
BASIC_AUTH_USER=revisor
# Lag med: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'passord'
BASIC_AUTH_HASH=
