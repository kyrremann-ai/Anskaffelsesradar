# demo = fiktive data, live = TED + Brreg (+ Doffin hvis nøkkel)
RADAR_MODE=demo
TED_FROM=2025-01-01
# Automatisk oppdatering hver N time (0 = bare manuelt)
REFRESH_HOURS=24

# Gratis nøkkel fra DFØs API-portal (Doffin Public API v2)
DOFFIN_API_KEY=
# Mistral (EU). Tom = regelbasert mal i stedet for LLM.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Hemmelig salt for person-nøkler fra Brreg-roller. Ikke endre etter første kjøring.
PERSON_SALT=bytt-til-en-lang-tilfeldig-streng
BRREG_USER_AGENT=Anskaffelsesradar/2.0 (kontakt: din@epost.no)

# --- Tilleggskilder (live) ---
# Regnskapsregisteret (åpent). 1 = på
REGNSKAP=1
# Proff API (valgfritt, krever avtale med Proff). Tom = av. Vi skraper ikke proff.no.
PROFF_API_KEY=
PROFF_BASE_URL=https://api.proff.no
PROFF_AUTH_SCHEME=Token
# Arbeidstilsynets registre (åpne, NLOD). Tom = av.
RENHOLD_REGISTER_URL=https://registerdata.arbeidstilsynet.no/renhold_register.xml
BEMANNING_REGISTER_URL=
# OpenSanctions: CC BY-NC, krever lisens ved kommersiell bruk. Tom = av.
# https://data.opensanctions.org/datasets/latest/default/targets.simple.csv
OPENSANCTIONS_URL=
OPENSANCTIONS_API_KEY=
# Filer i data/import/ leses ved hver oppdatering:
#   aksjonaer*.csv (Skatteetaten), kandidat*.csv (valg.no), kofa*.csv|json

# Caddy
DOMAIN=radar.example.no
BASIC_AUTH_USER=revisor
# Lag med: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'passord'
BASIC_AUTH_HASH=
